#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp CAPSLOCK      &kp ASTRK  &kp CARET  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp HASH                                                                       &kp PERCENT  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp AMPERSAND  &kp MINUS  &kp EQUAL
&kp TAB           &kp Q      &kp W      &kp F             &kp P                 &kp G           &kp GRAVE                                                                      &kp DLLR     &kp J            &kp L                  &kp U              &kp Y          &none      &kp PIPE
&kp ESC           &kp A      &kp R      &kp S             &kp T                 &kp D           &kp AT         &kp ESC         &kp LEFT_ALT      &kp DELETE  &kp LEFT_CONTROL  &kp EXCL     &kp H            &kp N                  &kp E              &kp I          &kp O      &kp COLON
&kp LEFT_CONTROL  &kp Z      &kp X      &kp C             &kp V                 &kp B                                          &mo 1             &kp HOME                                   &kp K            &kp M                  &kp COMMA          &kp DOT        &kp SEMI   &kp LEFT_WIN
&mo 3             &trans     &kp EQUAL  &kp SINGLE_QUOTE  &kp SLASH                             &kp BACKSPACE  &kp LEFT_SHIFT  &mo 2             &kp END     &kp ENTER         &kp SPACE                     &kp PAGE_DOWN          &kp PAGE_UP        &kp BACKSLASH  &trans     &to 4
            >;
        };

        hotkeys {
            bindings = <
&trans  &kp F1  &kp F2          &kp F3          &kp F4          &kp F5          &kp F6                                      &kp F7  &kp F8          &kp F9          &kp F10         &kp F11         &kp F12  &trans
&trans  &trans  &kp LS(LC(F1))  &kp LS(LC(F2))  &kp LS(LC(F3))  &kp LS(LC(F4))  &trans                                      &trans  &kp LS(LC(F5))  &kp LS(LC(F6))  &kp LS(LC(F7))  &kp LS(LC(F8))  &trans   &trans
&trans  &kp N1  &kp N2          &kp N3          &kp N4          &kp N5          &trans  &trans  &trans      &trans  &trans  &trans  &kp N6          &kp N7          &kp N8          &kp N9          &kp N0   &trans
&trans  &trans  &kp LC(LA(F1))  &kp LC(LA(F2))  &kp LC(LA(F3))  &kp LC(LA(F4))                  &trans      &trans                  &kp LC(LA(F5))  &kp LC(LA(F6))  &trans          &trans          &trans   &trans
&trans  &trans  &trans          &trans          &trans                          &trans  &trans  &trans      &trans  &trans  &trans                  &trans          &trans          &trans          &trans   &trans
            >;
        };

        navigation {
            bindings = <
&trans  &trans  &trans  &trans                &trans        &trans            &trans                                         &trans        &trans     &trans            &trans           &trans             &trans  &trans
&trans  &trans  &kp W   &trans                &trans        &trans            &trans                                         &trans        &trans     &kp LEFT_BRACKET  &kp UP           &kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &trans  &kp LS(LEFT_CONTROL)  &kp LEFT_WIN  &kp LEFT_CONTROL  &trans  &trans  &trans      &trans  &trans     &trans        &kp MINUS  &kp LEFT          &kp DOWN         &kp RIGHT          &trans  &kp B
&trans  &trans  &trans  &trans                &trans        &kp LEFT_SHIFT                    &trans      &trans                           &kp EQUAL  &kp PAGE_DOWN     &trans           &kp PG_UP          &trans  &trans
&trans  &trans  &trans  &trans                &trans                          &trans  &trans  &trans      &trans  &kp ENTER  &kp LEFT_ALT             &kp SCROLLLOCK    &kp PAUSE_BREAK  &kp INS            &trans  &trans
            >;
        };

        kinesis {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        qwertyinneed {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 4                                                   &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &to 0
            >;
        };
    };
};
